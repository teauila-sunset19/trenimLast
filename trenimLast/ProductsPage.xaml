<Page x:Class="trenimLast.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:trenimLast"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductsPage" FontFamily="Arial">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
            <StackPanel >
                <WrapPanel Name ="FIOPanel">
                    <TextBlock Text="Пользователь: " FontSize="16"/>
                    <TextBlock Name="FIOBloxk" FontSize="16" Margin="0,0,20,0"/>
                </WrapPanel>
                <WrapPanel Name="rolyPanel">
                    <TextBlock Text="Роль: " FontSize="16"/>
                    <TextBlock Name="RolyBlock" FontSize="16"/>
                </WrapPanel>
                <Button Content="Добавить" Name="addBtn" Click="addBtn_Click" Visibility="{Binding VisibleBtn}"/>
            </StackPanel>
            
        </WrapPanel>

        <WrapPanel Grid.Row="0" Margin="10,10,0,0">
            <WrapPanel Name="searchPanel">
                <TextBlock Text="Поиск: " FontSize="16"/>
                <TextBox Name="searchBox" FontSize="16" Width="200" TextChanged="searchBox_TextChanged"/>
            </WrapPanel>
            <StackPanel Name="FilterPanel">
                <WrapPanel >
                    <TextBlock Text="Фильтрация: " FontSize="16"/>
                    <ComboBox Name="filterCombo" FontSize="16" Width="200" SelectionChanged="filterCombo_SelectionChanged">
                        <TextBlock>Все Поставщики</TextBlock>
                        <TextBlock>Vinylon</TextBlock>
                        <TextBlock>Knauf</TextBlock>
                        <TextBlock>Playbig</TextBlock>
                        <TextBlock>CHILITOY</TextBlock>
                    </ComboBox>
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="Сортировка: " FontSize="16"/>
                    <ComboBox Name="sortCombo" FontSize="16" Width="200" SelectionChanged="sortCombo_SelectionChanged">
                        <TextBlock>Без сортировки</TextBlock>
                        <TextBlock>По возрастанию цены</TextBlock>
                        <TextBlock>По убыванию цены</TextBlock>
                        <TextBlock>По возрастанию количества на складе</TextBlock>
                        <TextBlock>По убыванию количества на складе</TextBlock>
                    </ComboBox>
                </WrapPanel>
                
            </StackPanel>
        </WrapPanel>
        <ListView Name="productsListview" Grid.Row="1" Grid.ColumnSpan="2">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Background="{Binding back}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="700"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Column="0" Grid.RowSpan="7" Stretch="UniformToFill" Width="100">
                            <Image.Source>
                                <Binding Path="imageCorrect">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            /content/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <WrapPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="{Binding correctCat}" FontSize="20" FontWeight="Bold" Margin="0,0,5,0" TextWrapping="WrapWithOverflow"/>
                            <TextBlock Text="{Binding nameProducts, StringFormat= | {0}}" FontSize="20" FontWeight="Bold" TextWrapping="WrapWithOverflow"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding opisav, StringFormat=Описание товара: {0}}" FontSize="14" Grid.Column="1" Grid.Row="1" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding proisvod, StringFormat=Производитель: {0}}" FontSize="14" Grid.Column="1" Grid.Row="2"/>
                        <TextBlock Text="{Binding postav, StringFormat=Поставщик: {0}}" FontSize="14" Grid.Column="1" Grid.Row="3"/>
                        <WrapPanel Grid.Column="1" Grid.Row="4">
                            <TextBlock Text="Цена: " FontSize="14" />
                            <TextBlock Text="{Binding OldCost}" FontSize="14" Foreground="Red" TextDecorations="Strikethrough"/>
                            <TextBlock Text="{Binding NewCost}" FontSize="14" Margin="5,0,0,0"/>
                        </WrapPanel>
                        
                        <TextBlock Text="{Binding capacity, StringFormat=Единица измерения: {0}}" FontSize="14" Grid.Column="1" Grid.Row="5"/>
                        <TextBlock Text="{Binding countInStorage, StringFormat=Количество на складе: {0}}" FontSize="14" Grid.Column="1" Grid.Row="6"/>
                        <WrapPanel Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding descount}" FontSize="14" />
                            <TextBlock Text=" %" FontSize="14"/>
                        </WrapPanel>
                        <Button Content="Редактировать" Name="editBtn" Grid.Column="2" Grid.Row="4" Click="editBtn_Click" Visibility="{Binding VisibleBtn}"/>
                        <Button Content="Удалить" Name="deleteBtn" Grid.Column="2" Grid.Row="5" Click="deleteBtn_Click" Visibility="{Binding VisibleBtn}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
