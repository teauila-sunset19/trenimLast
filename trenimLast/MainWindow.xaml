<Window x:Class="trenimLast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:trenimLast"
        mc:Ignorable="d"
        Title="МирИгрушек" Height="450" Width="800" Icon="/content/icon.ico" FontFamily="Arial">
    <Grid Background="#F5DEB3">
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Image Source="/content/icon.jpg" HorizontalAlignment="Left"/>
        <TextBlock Text="ООО «МирИгрушек»" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30"/>
        <Button Name="BtnBack" Content="Назад" HorizontalAlignment="Right" Click="BtnBack_Click"/>
        <Frame Grid.Row="1" Name="MainFrame" NavigationUIVisibility="Hidden" ContentRendered="MainFrame_ContentRendered"/>
    </Grid>
</Window>
