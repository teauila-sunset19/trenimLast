<Page x:Class="trenimLast.LogInPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:trenimLast"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LogInPage" FontFamily="Arial">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Логин: " FontSize="20" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"  HorizontalAlignment="Right"/>
        <TextBlock Text="Пароль: " FontSize="20" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"  HorizontalAlignment="Right"/>
        <TextBox Name="loginBox" Grid.Row="0" Grid.Column="1" FontSize="16" Width="200" Height="20" HorizontalAlignment="Left"/>
        <TextBox Name="passwordBox" Grid.Row="1" Grid.Column="1" FontSize="16" Width="200" Height="20" HorizontalAlignment="Left"/>
        <Button Content="Войти" Name="LogInBtn" Grid.Column="0" Grid.Row="2" Click="LogInBtn_Click"/>
        <Button Content="Войти как гость" Name="GeustBtn" Grid.Column="1" Grid.Row="2" Click="GeustBtn_Click"/>
    </Grid>
</Page>
